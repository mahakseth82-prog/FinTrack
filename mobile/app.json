{
  "expo": {
    "name": "FinTrack",
    "slug": "fintrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "android": {
      "package": "com.fintrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-audio"
    ]
  }
}
