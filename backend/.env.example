# ============================================================================
# FinTrack Backend — Environment Variables (.env)
# Copy this file to backend/.env and fill in your real credentials
# ============================================================================
PORT=5000

# 1. Supabase Configuration (Get from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Google Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=
